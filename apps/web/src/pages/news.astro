---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

import { createSupabaseServerClient } from '@/lib/supabase';
import { getPageSections, listNews } from '@/services/content';
import { siteToBusiness } from '@/lib/content';

const site = Astro.locals.site;
if (!site) return new Response(null, { status: 404 });

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const [home, news] = await Promise.all([
  getPageSections(supabase, site.id, 'home'),
  listNews(supabase, site.id),
]);
const business = siteToBusiness(site);

const dateFor = (value: string | null) =>
  value ? new Date(value).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) : null;
---

<Layout title={`Actualités — ${site.name}`} description={site.seo.defaultDescription}>
  <Header business={business} />
  <main>
    <PageHeader
      eyebrow="— Actualités"
      title="Dernières actualités"
      breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Actualités' }]}
    />

    <section class="listing">
      <div class="wrap">
        {news.length === 0 ? (
          <p class="empty">Aucune actualité publiée pour le moment.</p>
        ) : (
          <ul class="items">
            {news.map(n => (
              <li class="item">
                <a href={`/news/${n.legacy_id}/${n.slug}`}>
                  {dateFor(n.published_at) && <time datetime={n.published_at!}>{dateFor(n.published_at)}</time>}
                  <h2>{n.title}</h2>
                  {n.excerpt && <p>{n.excerpt}</p>}
                  <span class="more">Lire la suite →</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <CTA cta={home.cta} />
  </main>
  <Footer footer={home.footer} business={business} />
</Layout>

<style>
  .listing { padding: 4rem 1.5rem; background: var(--bg); }
  .wrap { max-width: 820px; margin: 0 auto; }
  .empty { color: var(--inkFaint); text-align: center; padding: 3rem 0; }
  .items { list-style: none; margin: 0; padding: 0; }
  .item + .item { margin-top: 1.25rem; }
  .item {
    background: var(--bgCard, var(--paper));
    border: 1px solid var(--lineSoft, var(--line));
    border-radius: var(--radius-lg, 12px);
    transition: border-color .2s ease;
  }
  .item:hover { border-color: var(--primary); }
  .item a { display: block; padding: 1.75rem; text-decoration: none; color: inherit; }
  time { font-size: .8125rem; color: var(--inkFaint); }
  .item h2 {
    margin: .5rem 0 .625rem; font-family: var(--fontHeading), serif;
    font-size: 1.375rem; line-height: 1.3; color: var(--ink);
  }
  .item p { margin: 0 0 1rem; color: var(--inkSoft); font-size: .9375rem; line-height: 1.65; }
  .more { font-size: .875rem; font-weight: 600; color: var(--primary); }
</style>

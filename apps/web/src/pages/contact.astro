---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

import { createSupabaseServerClient } from '@/lib/supabase';
import { getPageSections } from '@/services/content';
import { siteToBusiness } from '@/lib/content';

const site = Astro.locals.site;
if (!site) return new Response(null, { status: 404 });

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const home = await getPageSections(supabase, site.id, 'home');
const business = siteToBusiness(site);
const contact = (home.contact ?? {}) as { title?: string; subtitle?: string; eyebrow?: string };
---

<Layout title={`Contact — ${site.name}`} description={site.seo.defaultDescription}>
  <Header business={business} />
  <main>
    <PageHeader
      eyebrow={contact.eyebrow}
      title={contact.title ?? 'Nous contacter'}
      subtitle={contact.subtitle}
      breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]}
    />
    <Contact contact={home.contact} business={business} />
  </main>
  <Footer footer={home.footer} business={business} />
</Layout>

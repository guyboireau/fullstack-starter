---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '@/lib/supabase';
import { listMemberSites, listAllServices, listAllAchievements, listAllNews } from '@/services/admin-content';

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const memberships = await listMemberSites(supabase);
const site = memberships[0]?.sites ?? null;

let fetchError = '';
let services: unknown[] = [];
let achievements: unknown[] = [];
let news: { published: boolean }[] = [];

if (site) {
  try {
    [services, achievements, news] = await Promise.all([
      listAllServices(supabase, site.id),
      listAllAchievements(supabase, site.id),
      listAllNews(supabase, site.id),
    ]);
  } catch (e) {
    fetchError = e instanceof Error ? e.message : 'Erreur de chargement';
  }
}

const drafts = news.filter(n => !n.published).length;

const stats = [
  { label: 'Services',      value: services.length,     href: '/admin/services' },
  { label: 'Réalisations',  value: achievements.length, href: '/admin/realisations' },
  { label: 'Actualités',    value: news.length,         href: '/admin/actualites' },
  { label: 'Brouillons',    value: drafts,              href: '/admin/actualites' },
];
---

<AdminLayout title="Dashboard">
  {!site && (
    <div class="mb-6 px-4 py-3 rounded-lg bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 text-sm">
      Votre compte n’est rattaché à aucun site. Ajoutez une ligne dans <code>site_members</code> pour lui donner accès.
    </div>
  )}
  {fetchError && (
    <div class="mb-6 px-4 py-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm">{fetchError}</div>
  )}

  {site && (
    <>
      <p class="text-sm text-gray-400 mb-6">
        Contenu du site <span class="text-gray-200 font-medium">{site.name}</span>.
      </p>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {stats.map(stat => (
          <a href={stat.href} class="block bg-gray-900 border border-gray-800 hover:border-gray-700 rounded-xl p-5 transition-colors">
            <p class="text-3xl font-semibold text-white">{stat.value}</p>
            <p class="text-sm text-gray-400 mt-1">{stat.label}</p>
          </a>
        ))}
      </div>

      <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
        <h2 class="text-sm font-medium text-gray-200 mb-2">Le site public lit directement ces tables</h2>
        <p class="text-sm text-gray-400">
          Toute publication est visible immédiatement sur <a href="/" class="text-indigo-400 hover:text-indigo-300">le site</a>.
          Un contenu non publié reste visible ici, mais pas des visiteurs.
        </p>
      </div>
    </>
  )}
</AdminLayout>

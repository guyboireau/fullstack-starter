# ======================
# Supabase
# ======================
# À récupérer sur https://app.supabase.com → Project Settings → API
#
# Ces variables sont lues côté serveur uniquement (Astro SSR + NestJS).
# Elles ne sont jamais exposées au navigateur : ne pas les préfixer PUBLIC_.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Clé service_role — API NestJS uniquement, contourne les RLS.
# Ne JAMAIS l'exposer côté navigateur ni la commiter.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ======================
# Front Astro (apps/web)
# ======================
# URL de l'API NestJS appelée par le panneau d'administration.
# En production, renseigner l'URL publique de l'API déployée.
API_URL=http://localhost:3000

# ======================
# API NestJS (apps/api)
# ======================
API_PORT=3000
# Origine autorisée par CORS = URL du front Astro (4321 en développement).
CORS_ORIGIN=http://localhost:4321

# ======================
# PostgreSQL (Docker Compose, développement local)
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fullstack_starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_starter

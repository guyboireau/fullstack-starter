# ======================
# Supabase Configuration
# ======================
# Get these from: https://app.supabase.com → Project Settings → API
# NB : le front (Astro SSR) et l'API lisent SUPABASE_URL / SUPABASE_ANON_KEY
# SANS préfixe VITE_ (le préfixe VITE_ était un héritage React/Vite, désormais inutile).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# API uniquement — validation des JWT (ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ======================
# API Configuration
# ======================
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
# URL de l'API appelée par le front (services/items.ts) — défaut http://localhost:3000
API_URL=http://localhost:3000

# ======================
# Database (for Docker Compose local dev)
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fullstack_starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_starter
